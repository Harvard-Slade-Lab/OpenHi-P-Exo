	(text "Battery, pack connector\nand emergency stop" (exclude_from_sim no) (at 24.13 36.83 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "968414b9-f2c2-5503-8107-607134a22801"))
